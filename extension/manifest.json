{
    "manifest_version": 3,
    "name": "Little Alchemy Co-op",
    "short_name": "LA Co-op",
    "version": "0.3.0",
    "description": "Play Little Alchemy classic together: every discovery syncs live between friends, peer-to-peer. Unofficial fan project.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Little Alchemy Co-op",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://littlealchemy.com/*",
                "https://www.littlealchemy.com/*"
            ],
            "js": [
                "dist/coop.js"
            ],
            "world": "MAIN",
            "run_at": "document_idle"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "little-alchemy-coop@fan-project",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
